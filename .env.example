# Copia este archivo a .env y ajusta los valores.
# Local con Docker o Postgres en la máquina: las dos URLs pueden ser iguales.
# En Supabase, DATABASE_URL es el pooler (puerto 6543) y DIRECT_URL es la conexión directa (puerto 5432).

DATABASE_URL="postgresql://textilenlace:textilenlace@localhost:5432/textilenlace?schema=public"
DIRECT_URL="postgresql://textilenlace:textilenlace@localhost:5432/textilenlace?schema=public"

# Mínimo 16 caracteres. En Vercel usa un valor distinto y largo.
AUTH_SECRET="cambia-esta-clave-por-una-larga-y-aleatoria"

# URL pública del sitio. En local es esta. En Vercel, la URL del proyecto.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
